{
  "name": "@oomol-lab/open-connector",
  "version": "0.0.0-development",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-generated.ts",
    "dev": "node scripts/dev-local.ts",
    "build": "npm run typecheck",
    "build:web": "npm run build --workspace web",
    "build:binary": "npm run generate:catalog && npm run build:web && bun scripts/build-binary.ts",
    "dev:cloudflare": "npm run generate:catalog && npm run build:web && node scripts/copy-catalog-assets.ts && wrangler dev --config wrangler.local.jsonc",
    "deploy:cloudflare": "npm run generate:catalog && npm run build:web && node scripts/copy-catalog-assets.ts && wrangler deploy --config wrangler.local.jsonc --minify",
    "start": "node scripts/ensure-generated.ts && node src/server/index.ts",
    "test": "vitest run",
    "typecheck": "npm run generate:registry && node scripts/typecheck.ts",
    "generate:registry": "node scripts/generate-provider-registry.ts",
    "generate:catalog": "node scripts/generate-catalog.ts",
    "runtime:migrate": "node scripts/runtime-data.ts migrate",
    "runtime:data": "node scripts/runtime-data.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "fix": "npm run lint:fix && npm run format:fix",
    "fix-check": "npm run fix && npm run typecheck",
    "build:runtime": "npm run generate:catalog && node scripts/build-runtime-package.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@scalar/hono-api-reference": "^0.12.12",
    "ali-oss": "^6.23.0",
    "busboy": "^1.6.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "hono": "^4.13.13",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.4.0",
    "jose": "^6.2.12",
    "mailparser": "^3.9.38",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "^7.2.0",
    "mqtt": "^5.16.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@hyrious/configs": "^0.1.6",
    "@types/ali-oss": "^6.23.3",
    "@types/bun": "1.4.0",
    "@types/busboy": "^1.5.5",
    "@types/mailparser": "^3.9.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
