{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenConnector Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag":        { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imageDigest":      { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create":                     { "type": "boolean" },
        "annotations":                { "type": "object" },
        "name":                       { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext":    { "type": "object" },
    "podAntiAffinity": {
      "type": "object",
      "properties": {
        "preferredDuringScheduling": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type":        { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port":        { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled":    { "type": "boolean" },
        "className":  { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host":  { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path":     { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hosts"],
            "properties": {
              "secretName": { "type": "string" },
              "hosts":      { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "properties": {
        "liveness":  { "type": "object", "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" } } },
        "readiness": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" } } },
        "startup":   { "type": "object", "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" } } }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled":          { "type": "boolean" },
        "mountPath":        { "type": "string" },
        "existingClaim":    { "type": "string" },
        "size":             { "type": "string" },
        "storageClassName": { "type": "string" },
        "accessModes":      { "type": "array", "items": { "type": "string" } },
        "annotations":      { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "origin":                { "type": "string" },
        "dataDir":               { "type": "string" },
        "allowedActions":        { "type": "string" },
        "blockedActions":        { "type": "string" },
        "allowedProxies":        { "type": "string" },
        "blockedProxies":        { "type": "string" },
        "allowedCustomOAuth":    { "type": "string" },
        "egressTrustedHosts":    { "type": "string" },
        "allowPrivateNetwork":   { "type": "boolean" },
        "logLevel":              { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
        "runLimit":              { "type": "integer", "minimum": 0 },
        "transitFileBackend":    { "type": "string", "enum": ["local", "s3"] },
        "transitFileTTLSeconds": { "type": "integer", "minimum": 0 },
        "transitFileMaxBytes":   { "type": "integer", "minimum": 0 },
        "s3Bucket":              { "type": "string" },
        "s3Region":              { "type": "string" },
        "s3Endpoint":            { "type": "string" },
        "s3ForcePathStyle":      { "type": "boolean" }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret":    { "type": "string" },
        "secretKeys":        { "type": "array", "items": { "type": "string" } },
        "annotations":       { "type": "object" },
        "encryptionKey":     { "type": "string" },
        "adminToken":        { "type": "string" },
        "runtimeToken":      { "type": "string" },
        "jwksUri":           { "type": "string" },
        "jwtIssuer":         { "type": "string" },
        "jwtAudience":       { "type": "string" },
        "s3AccessKeyId":     { "type": "string" },
        "s3SecretAccessKey": { "type": "string" },
        "s3SessionToken":    { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled":              { "type": "boolean" },
        "url":                  { "type": "string" },
        "poolMax":              { "type": "integer", "minimum": 1 },
        "connectTimeoutMs":     { "type": "integer", "minimum": 0 },
        "existingUrlSecret":    { "type": "string" },
        "existingUrlSecretKey": { "type": "string" },
        "migration": {
          "type": "object",
          "properties": {
            "enabled":     { "type": "boolean" },
            "backoffLimit": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage":    { "type": ["integer", "string"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "string"], "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled":        { "type": "boolean" },
        "minAvailable":   { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled":                            { "type": "boolean" },
        "ingressNamespaceSelector":           { "type": "object" },
        "additionalIngressNamespaceSelector": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "interval":      { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "annotations":   { "type": "object" },
            "labels":        { "type": "object" }
          }
        }
      }
    },
    "nodeSelector":     { "type": "object" },
    "tolerations":      { "type": "array" },
    "affinity":         { "type": "object" },
    "podAnnotations":   { "type": "object" },
    "podLabels":        { "type": "object" },
    "updateStrategy":   { "type": "object" },
    "extraEnv":         { "type": "array" },
    "extraVolumes":     { "type": "array" },
    "extraVolumeMounts":{ "type": "array" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}